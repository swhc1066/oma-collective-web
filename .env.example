# Public ticket platform URL — points to Zeffy / Givebutter / Eventbrite event page.
# Used by the Buy Tickets buttons site-wide.
NEXT_PUBLIC_TICKETS_URL=https://www.zeffy.com/en-US/ticketing/collective--26-2

# Optional: per-tier ticket URLs if you wire up multiple ticket levels.
# NEXT_PUBLIC_TICKETS_INDIVIDUAL_URL=
# NEXT_PUBLIC_TICKETS_TABLE_URL=
# NEXT_PUBLIC_TICKETS_SPONSOR_URL=

# Supabase project credentials (Project Settings → API). Safe to expose:
# the anon key only grants what RLS allows (anon reads published lots;
# authenticated admins get full CRUD). Never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The single email allowed into /admin. Sign-ins from any other address are
# rejected by middleware, even with valid Supabase credentials.
ALLOWED_ADMIN_EMAIL=
